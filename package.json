{
  "name": "@makecrypto/makepay-evershop",
  "version": "0.1.1",
  "description": "Official MakePay payment extension for EverShop.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/bootstrap.js",
  "types": "./dist/bootstrap.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@evershop/evershop": ">=2.0.0",
    "@evershop/postgres-query-builder": ">=2.0.0",
    "body-parser": ">=1.20.0",
    "config": ">=3.3.0",
    "react": ">=17.0.0",
    "react-toastify": ">=6.0.0"
  },
  "devDependencies": {
    "@evershop/evershop": "^2.1.2",
    "@evershop/postgres-query-builder": "^2.0.1",
    "@types/body-parser": "^1.19.5",
    "@types/config": "^3.3.5",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "body-parser": "^1.20.0",
    "config": "^3.3.6",
    "react": "^17.0.1",
    "react-toastify": "^6.2.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makecryptoio/makepay-evershop.git"
  },
  "keywords": [
    "evershop",
    "makepay",
    "makecrypto",
    "crypto-payments",
    "payment-gateway"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "pack:dry-run": "npm pack --dry-run --json"
  }
}
